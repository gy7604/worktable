<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_background">
<LinearLayout android:id="@+id/widget_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="일주일 근무 · 휴무·대근" android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
<TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#CBD5E1" android:paddingBottom="4dp"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:orientation="horizontal">
<TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="A조" android:textStyle="bold" android:textSize="12sp" android:textColor="#FDBA74"/>
<TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="B조" android:textStyle="bold" android:textSize="12sp" android:textColor="#86EFAC"/>
<TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="C조" android:textStyle="bold" android:textSize="12sp" android:textColor="#93C5FD"/>
<TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="D조" android:textStyle="bold" android:textSize="12sp" android:textColor="#FDE047"/>
</LinearLayout>
<ListView android:id="@+id/week_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="#50647A" android:dividerHeight="1dp" android:scrollbars="vertical"/>
<TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="앱에서 계정을 연결하고 동기화해 주세요." android:textSize="12sp" android:textColor="#FFFFFF"/>
</LinearLayout>